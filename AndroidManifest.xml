<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.aidemo.wordsprint"
    android:versionCode="59"
    android:versionName="8.2">

    <uses-permission android:name="android.permission.CAMERA"/>
    <uses-permission android:name="android.permission.INTERNET"/>
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES"/>
    <uses-feature android:name="android.hardware.camera" android:required="false"/>

    <application
        android:name=".App"
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:allowBackup="true"
        android:hardwareAccelerated="true"
        android:supportsRtl="false"
        android:usesCleartextTraffic="true"
        android:theme="@style/Theme.WordsPrint">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity android:name=".SetupActivity" android:exported="false" android:theme="@style/Sheet" android:configChanges="orientation|screenSize" android:windowSoftInputMode="stateHidden"/>
        <activity android:name=".StudyActivity" android:exported="false"
            android:theme="@style/Theme.WordsPrint"
            android:configChanges="orientation|screenSize|keyboardHidden" />
        <activity android:name=".SettingsActivity" android:exported="false" />
        <!-- 设置的子页面（外观 / 学习 / 数据与档案 / 关于与更新），像微信那样一层层进去 -->
        <activity android:name=".SettingsSubActivity" android:exported="false" />
        <!-- 多用户档案：新建/切换/改名/删除；首次使用由 MainActivity 拉起来 -->
        <activity android:name=".ProfileActivity" android:exported="false"
            android:configChanges="orientation|screenSize|keyboard|keyboardHidden|navigation"
            android:windowSoftInputMode="stateHidden|adjustResize" />
        <activity android:name=".SearchActivity" android:exported="false"
            android:configChanges="orientation|screenSize|keyboard|keyboardHidden|navigation"
            android:windowSoftInputMode="stateVisible|adjustResize" />
        <!-- 错题本（用户：删除收藏功能，首页空出来的位置改放错题本） -->
        <activity android:name=".WrongActivity" android:exported="false" />
        <!-- 词表预览 + 批量改进度（用户：「词本加一个仅预览，还可以直接批量编辑」） -->
        <activity android:name=".BookPreviewActivity" android:exported="false"
            android:configChanges="orientation|screenSize" />
        <activity android:name=".ShareActivity" android:exported="false" />
        <activity android:name=".ExportActivity" android:exported="false" />
        <!-- keyboard/keyboardHidden 必须自己吃掉：否则弹窗/输入框一弹键盘 Activity 就被重建（v1.0.13 装机实测"点粘贴就退出"） -->
        <activity android:name=".ScanActivity" android:exported="false"
            android:theme="@style/Theme.WordsPrint.Scan" android:screenOrientation="portrait"
            android:configChanges="orientation|screenSize|keyboard|keyboardHidden|navigation"
            android:windowSoftInputMode="stateHidden|adjustResize" />
        <activity android:name=".PasteImportActivity" android:exported="false"
            android:configChanges="orientation|screenSize|keyboard|keyboardHidden|navigation"
            android:windowSoftInputMode="stateVisible|adjustResize" />
        <provider
            android:name=".ApkProvider"
            android:authorities="com.aidemo.wordsprint.update"
            android:exported="false"
            android:grantUriPermissions="true"/>
    </application>
</manifest>
