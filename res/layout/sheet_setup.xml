<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- 上半屏遮罩：窗口本身只有 dim（Sheet 主题），普通 Activity 的
         setFinishOnTouchOutside 因内容视图铺满全屏而永远收不到"外面"的触摸，
         点上方没反应（用户反馈"点词本详情点上面不能退出"）。这里铺一层透明
         点击层，点它 = 关详情。 -->
    <View
        android:id="@+id/scrim"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>

    <LinearLayout
        android:id="@+id/sheetRoot"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:orientation="vertical"
        android:background="@drawable/bg_sheet"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="10dp"
        android:paddingBottom="18dp">

        <View
            android:layout_width="44dp"
            android:layout_height="4dp"
            android:layout_gravity="center_horizontal"
            android:background="@drawable/bg_handle"/>

        <!-- 标题行 -->
        <TextView
            android:id="@+id/tvBook"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="英语 · 必修第一册"
            android:textColor="?attr/wpText"
            android:textSize="22sp"
            android:textStyle="bold"
            android:maxLines="1"
            android:ellipsize="end"/>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/tvPubTag"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_tag"
                android:paddingStart="7dp"
                android:paddingEnd="7dp"
                android:paddingTop="2dp"
                android:paddingBottom="2dp"
                android:text="人教版"
                android:textColor="?attr/wpBrand"
                android:textSize="11sp"
                android:textStyle="bold"/>

            <TextView
                android:id="@+id/tvSeries"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="人教版 · 高中 · 共 377 词"
                android:textColor="?attr/wpText2"
                android:textSize="12sp"/>
        </LinearLayout>

        <!-- 环形进度 + 统计 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="horizontal"
            android:background="@drawable/bg_card_20"
            android:gravity="center_vertical"
            android:padding="14dp">

            <com.aidemo.wordsprint.RingProgress
                android:id="@+id/ring"
                android:layout_width="104dp"
                android:layout_height="104dp"/>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="16dp"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/group_size"
                    android:textColor="?attr/wpText2"
                    android:textSize="11sp"
                    android:letterSpacing="0.1"/>

                <HorizontalScrollView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="7dp"
                    android:scrollbars="none"
                    android:clipToPadding="false">

                    <LinearLayout
                        android:id="@+id/sizeChips"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"/>
                </HorizontalScrollView>
            </LinearLayout>
        </LinearLayout>

        

        <TextView
            android:id="@+id/tvStats"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_pill"
            android:gravity="center"
            android:paddingTop="10dp"
            android:paddingBottom="10dp"
            android:text="已学 0 · 剩余 377 · 错词 0"
            android:textColor="?attr/wpText2"
            android:textSize="12.5sp"/>

        <!-- 顺序（回炉间隔 2026-09-23 起移到「设置 → 学习」全局设置，这里不再有） -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="vertical"
            android:background="@drawable/bg_card_20"
            android:padding="12dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/order_label"
                android:textColor="?attr/wpText2"
                android:textSize="11sp"
                android:letterSpacing="0.1"/>

            <LinearLayout
                android:id="@+id/orderChips"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="horizontal"/>
        </LinearLayout>

        <!-- 重刷整本 -->
        <LinearLayout
            android:id="@+id/rowRedo"
            style="@style/SettingRow"
            android:paddingTop="13dp"
            android:paddingBottom="13dp">

            <LinearLayout style="@style/SettingRowText">
                <TextView style="@style/SettingTitle" android:text="@string/redo_all" android:textSize="14sp"/>
            </LinearLayout>

            <Switch
                android:id="@+id/swRedo"
                style="@style/SettingSwitch"
                android:clickable="false"
                android:focusable="false"/>
        </LinearLayout>

        <!-- 工具行：四个等宽小按钮（预览词表 / 错题本 / 批量改进度 / 清除进度）。
             2026-09-15 从一整排挤在一起的动作里挑了真正常用的几个，等宽等高；
             2026-09-16 用户要求「每个词本打开时能看到总错题本加筛选」，补上「错题本」这一枚。 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/btnPreview"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_weight="1"
                android:background="@drawable/bg_pill"
                android:gravity="center"
                android:maxLines="1"
                android:text="@string/book_preview"
                android:textColor="?attr/wpBrand"
                android:textSize="12.5sp"
                android:textStyle="bold"/>

            <TextView
                android:id="@+id/btnWrong"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_pill"
                android:gravity="center"
                android:maxLines="1"
                android:text="@string/wrong_title"
                android:textColor="?attr/wpBrand"
                android:textSize="12.5sp"
                android:textStyle="bold"/>

            <TextView
                android:id="@+id/btnBatch"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_pill"
                android:gravity="center"
                android:maxLines="1"
                android:text="@string/book_batch"
                android:textColor="?attr/wpBrand"
                android:textSize="12.5sp"
                android:textStyle="bold"/>

            <TextView
                android:id="@+id/btnReset"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_pill"
                android:gravity="center"
                android:maxLines="1"
                android:text="@string/book_clear_progress"
                android:textColor="?attr/wpRed"
                android:textSize="12.5sp"
                android:textStyle="bold"/>
        </LinearLayout>

        <!-- 底部：开始刷词（错词复习 2026-09-23 起从词本弹层移除：去「错题本」页点「开始订正」） -->
        <TextView
            android:id="@+id/btnStart"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_btn_gradient"
            android:gravity="center"
            android:maxLines="1"
            android:text="@string/start_brush"
            android:textColor="#FFFFFFFF"
            android:textSize="15.5sp"
            android:textStyle="bold"/>
    </LinearLayout>
</FrameLayout>
