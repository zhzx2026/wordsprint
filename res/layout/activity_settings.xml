<?xml version="1.0" encoding="utf-8"?>
<!--
  设置首页（v2.15 重排：像微信那样一层层进去）。
  这一页只负责「分组导航」，每行点进去才是子页面：
    外观 / 学习 / 数据与档案 / 关于与更新（见 SettingsSubActivity + sub_*.xml）
  这样做的好处是每页只有一件事，不用在一个长列表里翻来翻去。
  改 id 记得两边一起改（SettingsActivity.java / SettingsSubActivity.java），scripts/refcheck.py 会查。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="?attr/wpBg">

    <!-- ===== 顶栏 ===== -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/bg_header_small"
        android:fitsSystemWindows="true"
        android:paddingStart="14dp"
        android:paddingEnd="16dp"
        android:paddingTop="8dp"
        android:paddingBottom="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <ImageView
                android:id="@+id/btnBack"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:padding="10dp"
                android:background="@drawable/bg_pill_white20"
                android:src="@drawable/ic_back"
                android:tint="#FFFFFFFF"
                android:contentDescription="@null"/>

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="12dp"
                android:text="@string/settings"
                android:textColor="#FFFFFFFF"
                android:textSize="18sp"
                android:textStyle="bold"/>
        </LinearLayout>

        <!-- 当前档案：一眼看到「现在是谁在刷」，点名字直接改名 -->
        <LinearLayout
            android:id="@+id/rowName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="2dp"
            android:layout_marginTop="10dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/bg_pill_white20"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:paddingTop="6dp"
            android:paddingBottom="6dp">

            <TextView
                android:id="@+id/tvNameNow"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/profile_title"
                android:textColor="#FFFFFFFF"
                android:textSize="13.5sp"
                android:textStyle="bold"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="@string/profile_rename"
                android:textColor="#D9FFFFFF"
                android:textSize="12sp"/>
        </LinearLayout>
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:scrollbars="none"
        android:clipToPadding="false"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:paddingTop="14dp"
        android:paddingBottom="26dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <LinearLayout style="@style/CardBox">

                <LinearLayout android:id="@+id/navAppearance" style="@style/SettingRow">
                    <LinearLayout style="@style/SettingRowText">
                        <TextView style="@style/SettingTitle" android:text="@string/nav_appearance" android:textStyle="bold"/>
                        <TextView style="@style/SettingDesc" android:text="@string/nav_appearance_desc"/>
                    </LinearLayout>
                    <ImageView android:layout_width="18dp" android:layout_height="18dp" android:tint="?attr/wpText2" android:src="@drawable/ic_chevron" android:contentDescription="@null"/>
                </LinearLayout>
                <View style="@style/SettingDivider"/>

                <LinearLayout android:id="@+id/navStudy" style="@style/SettingRow">
                    <LinearLayout style="@style/SettingRowText">
                        <TextView style="@style/SettingTitle" android:text="@string/nav_study" android:textStyle="bold"/>
                        <TextView style="@style/SettingDesc" android:text="@string/nav_study_desc"/>
                    </LinearLayout>
                    <ImageView android:layout_width="18dp" android:layout_height="18dp" android:tint="?attr/wpText2" android:src="@drawable/ic_chevron" android:contentDescription="@null"/>
                </LinearLayout>
                <View style="@style/SettingDivider"/>

                <LinearLayout android:id="@+id/navData" style="@style/SettingRow">
                    <LinearLayout style="@style/SettingRowText">
                        <TextView style="@style/SettingTitle" android:text="@string/nav_data" android:textStyle="bold"/>
                        <TextView style="@style/SettingDesc" android:text="@string/nav_data_desc"/>
                    </LinearLayout>
                    <ImageView android:layout_width="18dp" android:layout_height="18dp" android:tint="?attr/wpText2" android:src="@drawable/ic_chevron" android:contentDescription="@null"/>
                </LinearLayout>
                <View style="@style/SettingDivider"/>

                <LinearLayout android:id="@+id/navAbout" style="@style/SettingRow">
                    <LinearLayout style="@style/SettingRowText">
                        <TextView style="@style/SettingTitle" android:text="@string/nav_about" android:textStyle="bold"/>
                        <TextView android:id="@+id/tvAboutNow" style="@style/SettingDesc" android:text="@string/update_desc"/>
                    </LinearLayout>
                    <ImageView android:layout_width="18dp" android:layout_height="18dp" android:tint="?attr/wpText2" android:src="@drawable/ic_chevron" android:contentDescription="@null"/>
                </LinearLayout>
            </LinearLayout>

            <TextView
                android:id="@+id/tvVersionFooter"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:gravity="center"
                android:textColor="?attr/wpText2"
                android:textSize="11.5sp"/>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
