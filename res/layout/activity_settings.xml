<?xml version="1.0" encoding="utf-8"?>
<!--
  设置页（v2.4 重排）：
    ① 信息层级只有三层：分组标题（SectionHead）/ 卡片 / 卡片内的一行（SettingRow）。
    ② 一行只讲一件事：左边标题+说明，右边控件或当前值；点整行就进下一步。
    ③ 分组之间留 22dp 呼吸，组内用分隔线；配色全部走 wp 主题属性，跟着皮肤与深浅色走。
  本文件里的 id 与 SettingsActivity.java 一一对应，改名要两边一起改（scripts/refcheck.py 会查）。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="?attr/wpBg">

    <!-- ===== 顶栏 ===== -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/bg_header_small"
        android:fitsSystemWindows="true"
        android:paddingStart="14dp"
        android:paddingEnd="16dp"
        android:paddingTop="8dp"
        android:paddingBottom="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <ImageView
                android:id="@+id/btnBack"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:padding="10dp"
                android:background="@drawable/bg_pill_white20"
                android:src="@drawable/ic_back"
                android:tint="#FFFFFFFF"
                android:contentDescription="@null"/>

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="12dp"
                android:text="@string/settings"
                android:textColor="#FFFFFFFF"
                android:textSize="18sp"
                android:textStyle="bold"/>
        </LinearLayout>

        <!-- 当前档案就放在顶栏里：一眼看到「现在是谁在刷」，点名字直接改名 -->
        <LinearLayout
            android:id="@+id/rowName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="2dp"
            android:layout_marginTop="10dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/bg_pill_white20"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:paddingTop="6dp"
            android:paddingBottom="6dp">

            <TextView
                android:id="@+id/tvNameNow"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/profile_title"
                android:textColor="#FFFFFFFF"
                android:textSize="13.5sp"
                android:textStyle="bold"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="@string/profile_rename"
                android:textColor="#D9FFFFFF"
                android:textSize="12sp"/>
        </LinearLayout>
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:scrollbars="none"
        android:clipToPadding="false"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:paddingTop="6dp"
        android:paddingBottom="26dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- ================= 外观 ================= -->
            <TextView style="@style/SectionHead" android:text="@string/theme_title"/>

            <LinearLayout style="@style/CardBox">

                <!-- 深浅色 -->
                <LinearLayout style="@style/SettingRow">
                    <LinearLayout style="@style/SettingRowText">
                        <TextView style="@style/SettingTitle" android:text="@string/set_theme_title"/>
                        <TextView style="@style/SettingDesc" android:text="@string/set_theme_desc"/>
                    </LinearLayout>
                </LinearLayout>
                <LinearLayout
                    android:id="@+id/nightChips"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:paddingBottom="12dp"/>

                <View style="@style/SettingDivider"/>

                <!-- 配色方案 -->
                <LinearLayout style="@style/SettingRow">
                    <LinearLayout style="@style/SettingRowText">
                        <TextView style="@style/SettingTitle" android:text="@string/set_skin_title"/>
                        <TextView style="@style/SettingDesc" android:text="@string/set_skin_desc"/>
                    </LinearLayout>
                </LinearLayout>
                <LinearLayout
                    android:id="@+id/skinChips"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"/>
                <LinearLayout
                    android:id="@+id/skinPreview"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:layout_marginBottom="12dp"
                    android:orientation="horizontal"/>

                <View style="@style/SettingDivider"/>

                <!-- 字体 -->
                <LinearLayout style="@style/SettingRow">
                    <LinearLayout style="@style/SettingRowText">
                        <TextView style="@style/SettingTitle" android:text="@string/set_font_title"/>
                        <TextView style="@style/SettingDesc" android:text="@string/set_font_desc"/>
                    </LinearLayout>
                </LinearLayout>
                <LinearLayout
                    android:id="@+id/fontChips"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"/>
                <TextView
                    android:id="@+id/tvFontSample"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:layout_marginBottom="12dp"
                    android:gravity="center"
                    android:text="letter a · apple · 苹果"
                    android:textColor="?attr/wpText"
                    android:textSize="18sp"/>

                <View style="@style/SettingDivider"/>

                <!-- 字号 -->
                <LinearLayout style="@style/SettingRow">
                    <LinearLayout style="@style/SettingRowText">
                        <TextView style="@style/SettingTitle" android:text="@string/set_scale_title"/>
                        <TextView android:id="@+id/tvScaleDesc" style="@style/SettingDesc" android:text="@string/set_scale_desc"/>
                    </LinearLayout>
                </LinearLayout>
                <LinearLayout
                    android:id="@+id/scaleChips"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:paddingBottom="14dp"/>
            </LinearLayout>

            <!-- ================= 学习 ================= -->
            <TextView style="@style/SectionHead" android:text="@string/set_study_title"/>

            <LinearLayout style="@style/CardBox">

                <LinearLayout style="@style/SettingRow">
                    <LinearLayout style="@style/SettingRowText">
                        <TextView style="@style/SettingTitle" android:text="@string/set_speak"/>
                        <TextView style="@style/SettingDesc" android:text="@string/set_speak_desc"/>
                    </LinearLayout>
                    <Switch android:id="@+id/swSpeak" style="@style/SettingSwitch" android:clickable="false" android:focusable="false"/>
                </LinearLayout>
                <View style="@style/SettingDivider"/>

                <LinearLayout style="@style/SettingRow">
                    <LinearLayout style="@style/SettingRowText">
                        <TextView style="@style/SettingTitle" android:text="@string/set_phonetic"/>
                        <TextView style="@style/SettingDesc" android:text="@string/set_phonetic_desc"/>
                    </LinearLayout>
                    <Switch android:id="@+id/swPhonetic" style="@style/SettingSwitch" android:clickable="false" android:focusable="false"/>
                </LinearLayout>
                <View style="@style/SettingDivider"/>

                <LinearLayout style="@style/SettingRow">
                    <LinearLayout style="@style/SettingRowText">
                        <TextView style="@style/SettingTitle" android:text="@string/set_sound"/>
                        <TextView style="@style/SettingDesc" android:text="@string/set_sound_desc"/>
                    </LinearLayout>
                    <Switch android:id="@+id/swSound" style="@style/SettingSwitch" android:clickable="false" android:focusable="false"/>
                </LinearLayout>
                <View style="@style/SettingDivider"/>

                <LinearLayout style="@style/SettingRow">
                    <LinearLayout style="@style/SettingRowText">
                        <TextView style="@style/SettingTitle" android:text="@string/set_anim"/>
                        <TextView style="@style/SettingDesc" android:text="@string/set_anim_desc"/>
                    </LinearLayout>
                    <Switch android:id="@+id/swAnim" style="@style/SettingSwitch" android:clickable="false" android:focusable="false"/>
                </LinearLayout>
                <View style="@style/SettingDivider"/>

                <!-- 每组词数 -->
                <LinearLayout style="@style/SettingRow">
                    <LinearLayout style="@style/SettingRowText">
                        <TextView style="@style/SettingTitle" android:text="@string/default_size"/>
                        <TextView style="@style/SettingDesc" android:text="@string/default_size_desc"/>
                    </LinearLayout>
                </LinearLayout>
                <LinearLayout
                    android:id="@+id/sizeChips"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:paddingBottom="12dp"/>
                <View style="@style/SettingDivider"/>

                <!-- 每日目标 -->
                <LinearLayout style="@style/SettingRow">
                    <LinearLayout style="@style/SettingRowText">
                        <TextView style="@style/SettingTitle" android:text="@string/set_goal_title"/>
                        <TextView android:id="@+id/tvGoalDesc" style="@style/SettingDesc" android:text="@string/goal_pick_desc"/>
                    </LinearLayout>
                </LinearLayout>
                <LinearLayout
                    android:id="@+id/goalChips"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:paddingBottom="14dp"/>
            </LinearLayout>

            <!-- ================= 手势操作（用户自己定） ================= -->
            <TextView style="@style/SectionHead" android:text="@string/ges_title"/>

            <LinearLayout style="@style/CardBox">
                <LinearLayout style="@style/SettingRow">
                    <LinearLayout style="@style/SettingRowText">
                        <TextView style="@style/SettingTitle" android:text="@string/ges_subtitle"/>
                        <TextView style="@style/SettingDesc" android:text="@string/ges_note"/>
                    </LinearLayout>
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/gesBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingBottom="4dp"/>

                <View style="@style/SettingDivider"/>

                <LinearLayout style="@style/SettingRow">
                    <LinearLayout style="@style/SettingRowText">
                        <TextView style="@style/SettingTitle" android:text="@string/ges_reset"/>
                        <TextView style="@style/SettingDesc" android:text="@string/ges_reset_desc"/>
                    </LinearLayout>
                    <TextView
                        android:id="@+id/gesReset"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_pill_brand"
                        android:paddingStart="14dp"
                        android:paddingEnd="14dp"
                        android:paddingTop="7dp"
                        android:paddingBottom="7dp"
                        android:text="@string/ges_reset"
                        android:textColor="?attr/wpBrand"
                        android:textSize="13sp"/>
                </LinearLayout>
            </LinearLayout>

            <!-- ================= 我的 ================= -->
            <TextView style="@style/SectionHead" android:text="@string/set_mine_title"/>

            <LinearLayout style="@style/CardBox">
                <LinearLayout android:id="@+id/rowProfile" style="@style/SettingRow">
                    <LinearLayout style="@style/SettingRowText">
                        <TextView style="@style/SettingTitle" android:text="@string/set_profile_title"/>
                        <TextView android:id="@+id/tvProfileNow" style="@style/SettingDesc" android:text="@string/set_profile_desc"/>
                    </LinearLayout>
                    <ImageView android:layout_width="18dp" android:layout_height="18dp" android:tint="?attr/wpText2" android:src="@drawable/ic_chevron" android:contentDescription="@null"/>
                </LinearLayout>
                <View style="@style/SettingDivider"/>

                                <View style="@style/SettingDivider"/>

                <LinearLayout android:id="@+id/rowFav" style="@style/SettingRow">
                    <LinearLayout style="@style/SettingRowText">
                        <TextView style="@style/SettingTitle" android:text="@string/quick_fav"/>
                        <TextView android:id="@+id/tvFavNow" style="@style/SettingDesc" android:text="@string/fav_empty"/>
                    </LinearLayout>
                    <ImageView android:layout_width="18dp" android:layout_height="18dp" android:tint="?attr/wpText2" android:src="@drawable/ic_chevron" android:contentDescription="@null"/>
                </LinearLayout>
                <View style="@style/SettingDivider"/>

                <LinearLayout android:id="@+id/rowShare" style="@style/SettingRow">
                    <LinearLayout style="@style/SettingRowText">
                        <TextView style="@style/SettingTitle" android:text="@string/set_share_title"/>
                        <TextView style="@style/SettingDesc" android:text="@string/set_share_desc"/>
                    </LinearLayout>
                    <ImageView android:layout_width="18dp" android:layout_height="18dp" android:tint="?attr/wpText2" android:src="@drawable/ic_chevron" android:contentDescription="@null"/>
                </LinearLayout>
                <View style="@style/SettingDivider"/>

                <LinearLayout android:id="@+id/rowSearch" style="@style/SettingRow">
                    <LinearLayout style="@style/SettingRowText">
                        <TextView style="@style/SettingTitle" android:text="@string/quick_search"/>
                        <TextView style="@style/SettingDesc" android:text="@string/search_tip"/>
                    </LinearLayout>
                    <ImageView android:layout_width="18dp" android:layout_height="18dp" android:tint="?attr/wpText2" android:src="@drawable/ic_chevron" android:contentDescription="@null"/>
                </LinearLayout>
            </LinearLayout>

            <!-- ================= 数据与更新 ================= -->
            <TextView style="@style/SectionHead" android:text="@string/set_data_title"/>

            <LinearLayout style="@style/CardBox">
                <LinearLayout android:id="@+id/rowExport" style="@style/SettingRow">
                    <LinearLayout style="@style/SettingRowText">
                        <TextView style="@style/SettingTitle" android:text="@string/export_progress"/>
                        <TextView style="@style/SettingDesc" android:text="@string/transfer_desc"/>
                    </LinearLayout>
                    <ImageView android:layout_width="18dp" android:layout_height="18dp" android:tint="?attr/wpText2" android:src="@drawable/ic_chevron" android:contentDescription="@null"/>
                </LinearLayout>
                <View style="@style/SettingDivider"/>

                <LinearLayout android:id="@+id/rowScan" style="@style/SettingRow">
                    <LinearLayout style="@style/SettingRowText">
                        <TextView style="@style/SettingTitle" android:text="@string/scan_import"/>
                        <TextView style="@style/SettingDesc" android:text="@string/transfer_desc"/>
                    </LinearLayout>
                    <ImageView android:layout_width="18dp" android:layout_height="18dp" android:tint="?attr/wpText2" android:src="@drawable/ic_chevron" android:contentDescription="@null"/>
                </LinearLayout>
            </LinearLayout>

            <!-- 更新 -->
            <TextView style="@style/SectionHead" android:text="@string/update_title"/>

            <LinearLayout style="@style/CardBox">
                <LinearLayout style="@style/SettingRow">
                    <LinearLayout style="@style/SettingRowText">
                        <TextView style="@style/SettingTitle" android:text="@string/update_src_title"/>
                        <TextView android:id="@+id/tvUpdateState" style="@style/SettingDesc" android:text="@string/update_checking"/>
                    </LinearLayout>
                </LinearLayout>

                <!-- 下载进度：装包时一直挂在这儿，用户在哪一页都看得见（用户反馈「更新进度条没有」） -->
                <LinearLayout
                    android:id="@+id/updateProgressBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:paddingBottom="12dp">

                    <ProgressBar
                        android:id="@+id/pbUpdate"
                        style="?android:attr/progressBarStyleHorizontal"
                        android:layout_width="match_parent"
                        android:layout_height="8dp"
                        android:max="100"
                        android:progress="0"
                        android:progressDrawable="@drawable/progress_update"/>

                    <TextView
                        android:id="@+id/tvUpdateProgress"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:textColor="?attr/wpText2"
                        android:textSize="11.5sp"/>
                </LinearLayout>
                <LinearLayout
                    android:id="@+id/srcChips"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:paddingBottom="12dp"/>
                <View style="@style/SettingDivider"/>

                <LinearLayout style="@style/SettingRow">
                    <LinearLayout style="@style/SettingRowText">
                        <TextView style="@style/SettingTitle" android:text="@string/update_auto"/>
                        <TextView style="@style/SettingDesc" android:text="@string/update_auto_desc"/>
                    </LinearLayout>
                    <Switch android:id="@+id/swUpdate" style="@style/SettingSwitch" android:clickable="false" android:focusable="false"/>
                </LinearLayout>
                <View style="@style/SettingDivider"/>

                <LinearLayout style="@style/SettingRow">
                    <LinearLayout style="@style/SettingRowText">
                        <TextView style="@style/SettingTitle" android:text="@string/update_check_now"/>
                        <TextView android:id="@+id/tvAbout" style="@style/SettingDesc" android:text="@string/update_desc"/>
                    </LinearLayout>
                    <TextView
                        android:id="@+id/btnUpdateCheck"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_btn_gradient"
                        android:paddingStart="18dp"
                        android:paddingEnd="18dp"
                        android:paddingTop="9dp"
                        android:paddingBottom="9dp"
                        android:text="@string/update_check_now"
                        android:textColor="#FFFFFFFF"
                        android:textSize="13.5sp"/>
                </LinearLayout>
            </LinearLayout>

            <TextView
                android:id="@+id/tvVersionFooter"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:gravity="center"
                android:textColor="?attr/wpText2"
                android:textSize="11.5sp"/>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
