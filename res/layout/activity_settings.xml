<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="?attr/wpBg">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/bg_header"
        android:fitsSystemWindows="true"
        android:paddingStart="14dp"
        android:paddingEnd="20dp"
        android:paddingTop="8dp"
        android:paddingBottom="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <ImageView
                android:id="@+id/btnBack"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:padding="10dp"
                android:background="@drawable/bg_pill_white20"
                android:src="@drawable/ic_back"
                android:tint="#FFFFFFFF"
                android:contentDescription="@null"/>

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="10dp"
                android:text="@string/settings"
                android:textColor="#FFFFFFFF"
                android:textSize="18sp"
                android:textStyle="bold"/>
        </LinearLayout>
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:scrollbars="none"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:paddingTop="14dp"
        android:paddingBottom="20dp"
        android:clipToPadding="false">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- 学习偏好 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_card_20"
                android:paddingStart="15dp"
                android:paddingEnd="15dp">

                <LinearLayout style="@style/SettingRow">
                    <LinearLayout style="@style/SettingRowText">
                        <TextView style="@style/SettingTitle" android:text="@string/set_speak"/>
                        <TextView style="@style/SettingDesc" android:text="看卡与翻卡时自动发音"/>
                    </LinearLayout>
                    <Switch android:id="@+id/swSpeak" style="@style/SettingSwitch" android:clickable="false" android:focusable="false"/>
                </LinearLayout>
                <View style="@style/SettingDivider"/>
                <LinearLayout style="@style/SettingRow">
                    <LinearLayout style="@style/SettingRowText">
                        <TextView style="@style/SettingTitle" android:text="@string/set_phonetic"/>
                        <TextView style="@style/SettingDesc" android:text="单词下方显示音标"/>
                    </LinearLayout>
                    <Switch android:id="@+id/swPhonetic" style="@style/SettingSwitch" android:clickable="false" android:focusable="false"/>
                </LinearLayout>
                <View style="@style/SettingDivider"/>
                <LinearLayout style="@style/SettingRow">
                    <LinearLayout style="@style/SettingRowText">
                        <TextView style="@style/SettingTitle" android:text="@string/set_sound"/>
                        <TextView style="@style/SettingDesc" android:text="记住/回炉的轻音效与振动"/>
                    </LinearLayout>
                    <Switch android:id="@+id/swSound" style="@style/SettingSwitch" android:clickable="false" android:focusable="false"/>
                </LinearLayout>
                <View style="@style/SettingDivider"/>
                <LinearLayout style="@style/SettingRow">
                    <LinearLayout style="@style/SettingRowText">
                        <TextView style="@style/SettingTitle" android:text="@string/set_anim"/>
                        <TextView style="@style/SettingDesc" android:text="释义淡入与换卡动画"/>
                    </LinearLayout>
                    <Switch android:id="@+id/swAnim" style="@style/SettingSwitch" android:clickable="false" android:focusable="false"/>
                </LinearLayout>
            </LinearLayout>

            <!-- ===== 配色方案（多套皮肤） ===== -->
            <TextView style="@style/SectionHead" android:text="@string/set_theme_title"/>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_card_20"
                android:padding="13dp">
                <LinearLayout
                    android:id="@+id/skinChips"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"/>
                <LinearLayout
                    android:id="@+id/skinPreview"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:orientation="horizontal"/>
                <TextView
                    style="@style/SettingDesc"
                    android:text="@string/set_theme_desc"/>
            </LinearLayout>

            <!-- ===== 字体（内置字体保证字母 a 是单层写法） ===== -->
            <TextView style="@style/SectionHead" android:text="@string/set_font_title"/>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_card_20"
                android:padding="13dp">
                <LinearLayout
                    android:id="@+id/fontChips"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"/>
                <TextView
                    android:id="@+id/tvFontSample"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="letter a · a a a · 单词长这样"
                    android:textColor="?attr/wpText"
                    android:textSize="17sp"/>
                <TextView
                    style="@style/SettingDesc"
                    android:text="@string/set_font_desc"/>
            </LinearLayout>

            <!-- ===== 字号（大屏自适应） ===== -->
            <TextView style="@style/SectionHead" android:text="@string/set_scale_title"/>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_card_20"
                android:padding="13dp">
                <LinearLayout
                    android:id="@+id/scaleChips"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"/>
                <TextView
                    android:id="@+id/tvScaleDesc"
                    style="@style/SettingDesc"
                    android:text="@string/set_scale_desc"/>
            </LinearLayout>

            <!-- ===== 每日目标 ===== -->
            <TextView style="@style/SectionHead" android:text="@string/set_goal_title"/>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_card_20"
                android:padding="13dp">
                <LinearLayout
                    android:id="@+id/goalChips"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"/>
                <TextView
                    android:id="@+id/tvGoalDesc"
                    style="@style/SettingDesc"
                    android:text="@string/goal_pick_desc"/>
            </LinearLayout>

            <!-- ===== 档案 / 战绩 / 词本 / 查词 / 收藏 ===== -->
            <TextView style="@style/SectionHead" android:text="@string/set_profile_title"/>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_card_20"
                android:paddingStart="15dp"
                android:paddingEnd="15dp">

                <LinearLayout android:id="@+id/rowProfile" style="@style/SettingRow">
                    <LinearLayout style="@style/SettingRowText">
                        <TextView style="@style/SettingTitle" android:text="@string/set_profile_title"/>
                        <TextView android:id="@+id/tvProfileNow" style="@style/SettingDesc" android:text="@string/set_profile_desc"/>
                    </LinearLayout>
                    <ImageView android:layout_width="20dp" android:layout_height="20dp" android:tint="?attr/wpText2" android:src="@drawable/ic_chevron" android:contentDescription="@null"/>
                </LinearLayout>
                <View style="@style/SettingDivider"/>

                <LinearLayout android:id="@+id/rowShare" style="@style/SettingRow">
                    <LinearLayout style="@style/SettingRowText">
                        <TextView style="@style/SettingTitle" android:text="@string/set_share_title"/>
                        <TextView style="@style/SettingDesc" android:text="@string/set_share_desc"/>
                    </LinearLayout>
                    <ImageView android:layout_width="20dp" android:layout_height="20dp" android:tint="?attr/wpText2" android:src="@drawable/ic_chevron" android:contentDescription="@null"/>
                </LinearLayout>
                <View style="@style/SettingDivider"/>

                <LinearLayout android:id="@+id/rowPlan" style="@style/SettingRow">
                    <LinearLayout style="@style/SettingRowText">
                        <TextView style="@style/SettingTitle" android:text="@string/plan_title"/>
                        <TextView android:id="@+id/tvPlanNow" style="@style/SettingDesc" android:text="@string/plan_desc"/>
                    </LinearLayout>
                    <ImageView android:layout_width="20dp" android:layout_height="20dp" android:tint="?attr/wpText2" android:src="@drawable/ic_chevron" android:contentDescription="@null"/>
                </LinearLayout>
                <View style="@style/SettingDivider"/>

                <LinearLayout android:id="@+id/rowSearch" style="@style/SettingRow">
                    <LinearLayout style="@style/SettingRowText">
                        <TextView style="@style/SettingTitle" android:text="@string/quick_search"/>
                        <TextView style="@style/SettingDesc" android:text="@string/search_tip"/>
                    </LinearLayout>
                    <ImageView android:layout_width="20dp" android:layout_height="20dp" android:tint="?attr/wpText2" android:src="@drawable/ic_chevron" android:contentDescription="@null"/>
                </LinearLayout>
                <View style="@style/SettingDivider"/>

                <LinearLayout android:id="@+id/rowFav" style="@style/SettingRow">
                    <LinearLayout style="@style/SettingRowText">
                        <TextView style="@style/SettingTitle" android:text="@string/quick_fav"/>
                        <TextView android:id="@+id/tvFavNow" style="@style/SettingDesc" android:text="@string/fav_empty"/>
                    </LinearLayout>
                    <ImageView android:layout_width="20dp" android:layout_height="20dp" android:tint="?attr/wpText2" android:src="@drawable/ic_chevron" android:contentDescription="@null"/>
                </LinearLayout>
            </LinearLayout>

            <!-- ===== 手势操作 ===== -->
            <TextView style="@style/SectionHead" android:text="@string/ges_title"/>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_card_20"
                android:padding="15dp">
                <TextView style="@style/SettingDesc" android:paddingTop="0dp" android:text="@string/ges_up"/>
                <TextView style="@style/SettingDesc" android:text="@string/ges_down"/>
                <TextView style="@style/SettingDesc" android:text="@string/ges_left"/>
                <TextView style="@style/SettingDesc" android:text="@string/ges_right"/>
                <TextView style="@style/SettingDesc" android:text="@string/ges_tap"/>
                <TextView style="@style/SettingDesc" android:text="@string/ges_long"/>
            </LinearLayout>

            <!-- 外观 -->
            <TextView style="@style/SectionHead" android:text="@string/theme_title" android:paddingStart="4dp"/>

            <LinearLayout
                android:id="@+id/nightChips"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:background="@drawable/bg_card_20"
                android:padding="13dp"/>

            <!-- 默认每组词数 -->
            <TextView style="@style/SectionHead" android:text="@string/default_size"/>

            <LinearLayout
                android:id="@+id/sizeChips"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:background="@drawable/bg_card_20"
                android:padding="13dp"/>

            <!-- 更新 -->
            <TextView style="@style/SectionHead" android:text="@string/update_title"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_card_20"
                android:paddingStart="15dp"
                android:paddingEnd="15dp">

                <LinearLayout style="@style/SettingRow">
                    <LinearLayout style="@style/SettingRowText">
                        <TextView style="@style/SettingTitle" android:text="@string/update_auto"/>
                        <TextView style="@style/SettingDesc" android:text="打开书架时静默检查一次，有新版本才提醒"/>
                    </LinearLayout>
                    <Switch android:id="@+id/swUpdate" style="@style/SettingSwitch" android:clickable="false" android:focusable="false"/>
                </LinearLayout>
                <View style="@style/SettingDivider"/>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingTop="13dp"
                    android:paddingBottom="13dp">
                    <TextView style="@style/SettingTitle" android:text="@string/update_src"/>
                    <TextView style="@style/SettingDesc" android:text="@string/update_src_hint"
                        android:layout_marginTop="2dp"/>
                    <LinearLayout
                        android:id="@+id/srcChips"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginTop="9dp"/>
                    <TextView
                        android:id="@+id/btnUpdateCheck"
                        android:layout_width="match_parent"
                        android:layout_height="40dp"
                        android:layout_marginTop="10dp"
                        android:background="@drawable/bg_btn_gradient"
                        android:gravity="center"
                        android:text="@string/update_check"
                        android:textColor="#FFFFFFFF"
                        android:textSize="13.5sp"
                        android:textStyle="bold"/>
                    <TextView
                        android:id="@+id/tvUpdateState"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="7dp"
                        android:textColor="?attr/wpText2"
                        android:textSize="11.5sp"/>
                </LinearLayout>
            </LinearLayout>

            <!-- 进度互传 -->
            <TextView style="@style/SectionHead" android:text="@string/transfer_title"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_card_20"
                android:paddingStart="15dp"
                android:paddingEnd="15dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingTop="13dp"
                    android:text="@string/transfer_desc"
                    android:textColor="?attr/wpText2"
                    android:textSize="11.5sp"/>

                <LinearLayout style="@style/SettingRow" android:id="@+id/btnExport">
                    <LinearLayout style="@style/SettingRowText">
                        <TextView style="@style/SettingTitle" android:text="@string/export_qr"/>
                    </LinearLayout>
                    <ImageView android:layout_width="18dp" android:layout_height="18dp" android:src="@drawable/ic_chevron" android:tint="?attr/wpText2" android:contentDescription="@null"/>
                </LinearLayout>
                <View style="@style/SettingDivider"/>
                <LinearLayout style="@style/SettingRow" android:id="@+id/btnScan">
                    <LinearLayout style="@style/SettingRowText">
                        <TextView style="@style/SettingTitle" android:text="@string/scan_import"/>
                        <TextView style="@style/SettingDesc" android:text="@string/scan_import_desc"/>
                    </LinearLayout>
                    <ImageView android:layout_width="18dp" android:layout_height="18dp" android:src="@drawable/ic_chevron" android:tint="?attr/wpText2" android:contentDescription="@null"/>
                </LinearLayout>
            </LinearLayout>

            <TextView
                android:id="@+id/tvVersionFooter"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:gravity="center"
                android:text="@string/app_name"
                android:textColor="?attr/wpText2"
                android:textSize="11sp"
                android:letterSpacing="0.2"/>

            <TextView
                android:id="@+id/tvAbout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:gravity="center"
                android:textColor="?attr/wpText2"
                android:textSize="11sp"/>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
