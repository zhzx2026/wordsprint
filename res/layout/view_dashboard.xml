<?xml version="1.0" encoding="utf-8"?>
<!-- 首页可滚动区（作为词书列表的 header 挂上去，往下滚就收走，不挤占书单空间） -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="14dp"
    android:paddingEnd="14dp"
    android:paddingTop="12dp">

    <!-- ===== 今日目标 ===== -->
    <LinearLayout
        android:id="@+id/goalCard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/bg_card_22"
        android:clickable="true"
        android:focusable="true"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="14dp"
        android:paddingBottom="4dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/goalTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/goal_title"
                android:textColor="?attr/wpText"
                android:textSize="15sp"
                android:textStyle="bold"/>

            <TextView
                android:id="@+id/goalBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_pill_green"
                android:paddingStart="9dp"
                android:paddingEnd="9dp"
                android:paddingTop="4dp"
                android:paddingBottom="4dp"
                android:text="@string/goal_met"
                android:textColor="#FFFFFFFF"
                android:textSize="11.5sp"
                android:textStyle="bold"/>
        </LinearLayout>

        <TextView
            android:id="@+id/goalSub"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/goal_progress"
            android:textColor="?attr/wpText2"
            android:textSize="12.5sp"/>

        <ProgressBar
            android:id="@+id/goalBar"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="7dp"
            android:layout_marginTop="10dp"
            android:max="100"
            android:progress="0"
            android:progressDrawable="@drawable/progress_line"/>

        <!-- 三个习惯勾选：刷词目标 / 温习 / 自测 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="horizontal">

            <LinearLayout
                android:id="@+id/habitWord"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical"
                android:paddingTop="8dp"
                android:paddingBottom="10dp">

                <TextView
                    android:id="@+id/habitWordMark"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="○"
                    android:textColor="?attr/wpText2"
                    android:textSize="17sp"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="@string/goal_title"
                    android:textColor="?attr/wpText2"
                    android:textSize="11.5sp"/>
            </LinearLayout>

            <View
                android:layout_width="1dp"
                android:layout_height="34dp"
                android:layout_gravity="center_vertical"
                android:background="?attr/wpLine"/>

            <LinearLayout
                android:id="@+id/habitRev"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical"
                android:paddingTop="8dp"
                android:paddingBottom="10dp">

                <TextView
                    android:id="@+id/habitRevMark"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="○"
                    android:textColor="?attr/wpText2"
                    android:textSize="17sp"/>

                <TextView
                    android:id="@+id/habitRevSub"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="@string/habit_rev"
                    android:textColor="?attr/wpText2"
                    android:textSize="11.5sp"/>
            </LinearLayout>

            <View
                android:layout_width="1dp"
                android:layout_height="34dp"
                android:layout_gravity="center_vertical"
                android:background="?attr/wpLine"/>

            <LinearLayout
                android:id="@+id/habitTest"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical"
                android:paddingTop="8dp"
                android:paddingBottom="10dp">

                <TextView
                    android:id="@+id/habitTestMark"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="○"
                    android:textColor="?attr/wpText2"
                    android:textSize="17sp"/>

                <TextView
                    android:id="@+id/habitTestSub"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="@string/habit_test"
                    android:textColor="?attr/wpText2"
                    android:textSize="11.5sp"/>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <!-- ===== 学习热力图 ===== -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:orientation="vertical"
        android:background="@drawable/bg_card_22"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="14dp"
        android:paddingBottom="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/heat_title"
                android:textColor="?attr/wpText"
                android:textSize="15sp"
                android:textStyle="bold"/>

            <TextView
                android:id="@+id/heatStreak"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/streak_cur"
                android:textColor="?attr/wpAmber"
                android:textSize="12.5sp"
                android:textStyle="bold"/>
        </LinearLayout>

        <TextView
            android:id="@+id/heatSub"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:text="@string/heat_sub"
            android:textColor="?attr/wpText2"
            android:textSize="11.5sp"/>

        <HorizontalScrollView
            android:id="@+id/heatScroll"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:scrollbars="none"
            android:clipToPadding="false">

            <com.aidemo.wordsprint.HeatView
                android:id="@+id/heat"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
        </HorizontalScrollView>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/heatBest"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/streak_best"
                android:textColor="?attr/wpText2"
                android:textSize="11.5sp"/>

            <TextView
                android:id="@+id/heatEmpty"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/heat_none"
                android:textColor="?attr/wpText2"
                android:textSize="11sp"/>
            <View
                android:id="@+id/heatL1"
                android:layout_width="9dp"
                android:layout_height="9dp"
                android:layout_marginStart="6dp"/>
            <View
                android:id="@+id/heatL2"
                android:layout_width="9dp"
                android:layout_height="9dp"
                android:layout_marginStart="3dp"/>
            <View
                android:id="@+id/heatL3"
                android:layout_width="9dp"
                android:layout_height="9dp"
                android:layout_marginStart="3dp"/>
            <View
                android:id="@+id/heatL4"
                android:layout_width="9dp"
                android:layout_height="9dp"
                android:layout_marginStart="3dp"/>
        </LinearLayout>
    </LinearLayout>

    <!-- ===== 快捷入口 ===== -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:orientation="horizontal">

        <LinearLayout
            android:id="@+id/quickSearch"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical"
            android:background="@drawable/bg_card_field"
            android:paddingTop="11dp"
            android:paddingBottom="11dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/quick_search"
                android:textColor="?attr/wpText"
                android:textSize="13.5sp"
                android:textStyle="bold"/>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/quickFav"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:gravity="center"
            android:orientation="vertical"
            android:background="@drawable/bg_card_field"
            android:paddingTop="11dp"
            android:paddingBottom="11dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/quick_fav"
                android:textColor="?attr/wpText"
                android:textSize="13.5sp"
                android:textStyle="bold"/>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/quickShare"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:gravity="center"
            android:orientation="vertical"
            android:background="@drawable/bg_card_field"
            android:paddingTop="11dp"
            android:paddingBottom="11dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/quick_share"
                android:textColor="?attr/wpText"
                android:textSize="13.5sp"
                android:textStyle="bold"/>
        </LinearLayout>
    </LinearLayout>

    <TextView
        android:id="@+id/shelfTitle"
        style="@style/SectionHead"
        android:layout_marginTop="18dp"
        android:text="@string/select_book"/>
</LinearLayout>
