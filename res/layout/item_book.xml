<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:background="@drawable/bg_card_20"
    android:layout_marginTop="9dp"
    android:gravity="center_vertical"
    android:paddingStart="0dp"
    android:paddingEnd="14dp"
    android:paddingTop="14dp"
    android:paddingBottom="14dp">

    <View
        android:id="@+id/spine"
        android:layout_width="6dp"
        android:layout_height="44dp"
        android:layout_marginStart="9dp"
        android:layout_marginEnd="11dp"
        android:background="@drawable/bg_spine"/>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/tvTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:ellipsize="end"
                android:text="英语 · 必修第一册"
                android:textColor="?attr/wpText"
                android:textSize="16.5sp"
                android:textStyle="bold"/>

            <TextView
                android:id="@+id/tvPubTag"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="7dp"
                android:background="@drawable/bg_tag"
                android:paddingStart="6dp"
                android:paddingEnd="6dp"
                android:paddingTop="1.5dp"
                android:paddingBottom="1.5dp"
                android:text="人教版"
                android:textColor="?attr/wpBrand"
                android:textSize="10.5sp"
                android:textStyle="bold"/>
        </LinearLayout>

        <TextView
            android:id="@+id/tvCount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="400 词"
            android:textColor="?attr/wpText2"
            android:textSize="12sp"/>
    </LinearLayout>

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="end|center_vertical"
        android:layout_marginStart="10dp">

        <TextView
            android:id="@+id/tvPct"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="0%"
            android:textColor="?attr/wpBrand"
            android:textSize="13sp"
            android:textStyle="bold"/>

        <ProgressBar
            android:id="@+id/bar"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="72dp"
            android:layout_height="6dp"
            android:layout_marginTop="5dp"
            android:max="100"
            android:progress="0"
            android:progressDrawable="@drawable/progress_line"/>
    </LinearLayout>

    <!-- ⋯：仅预览词表 / 批量改进度（用户 2026-09-15：不想一个词一个词点） -->
    <TextView
        android:id="@+id/btnMore"
        android:layout_width="34dp"
        android:layout_height="44dp"
        android:layout_marginStart="4dp"
        android:background="@drawable/bg_circle_chip"
        android:gravity="center"
        android:text="⋯"
        android:textColor="?attr/wpText2"
        android:textSize="17sp"
        android:textStyle="bold"
        android:contentDescription="@string/book_more"/>
</LinearLayout>
