<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/wpBg">

    <!-- ===== 正常刷词界面 ===== -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- 渐变顶栏 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_header"
            android:fitsSystemWindows="true"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:paddingTop="8dp"
            android:paddingBottom="14dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <ImageView
                    android:id="@+id/btnClose"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:padding="10dp"
                    android:background="@drawable/bg_pill_white20"
                    android:src="@drawable/ic_close"
                    android:tint="#FFFFFFFF"
                    android:contentDescription="@string/quit_title"/>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="center">

                    <TextView
                        android:id="@+id/tvBookName"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:maxLines="1"
                        android:ellipsize="end"
                        android:textColor="#FFFFFFFF"
                        android:textSize="14.5sp"
                        android:textStyle="bold"/>

                    <TextView
                        android:id="@+id/tvGroupPill"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="1dp"
                        android:text="@string/this_group"
                        android:textColor="@color/white70"
                        android:textSize="10.5sp"/>
                </LinearLayout>

                <View
                    android:layout_width="40dp"
                    android:layout_height="40dp"/>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <ProgressBar
                    android:id="@+id/groupProgress"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="0dp"
                    android:layout_height="5dp"
                    android:layout_weight="1"
                    android:max="100"
                    android:progress="0"
                    android:progressDrawable="@drawable/progress_white"/>

                <TextView
                    android:id="@+id/tvPos"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:text="0 / 0"
                    android:textColor="#FFFFFFFF"
                    android:textSize="12sp"
                    android:fontFamily="monospace"/>
            </LinearLayout>
        </LinearLayout>

        <!-- 卡片区 -->
        <LinearLayout
            android:id="@+id/card"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:layout_marginTop="14dp"
            android:orientation="vertical"
            android:background="@drawable/bg_card_28">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:paddingTop="16dp">

                <TextView
                    android:id="@+id/tvWrongPill"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_pill_red"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp"
                    android:paddingTop="4dp"
                    android:paddingBottom="4dp"
                    android:textColor="?attr/wpRed"
                    android:textSize="11.5sp"
                    android:textStyle="bold"
                    android:visibility="gone"/>

                <View
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1"/>

                <ImageView
                    android:id="@+id/btnUndo"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:padding="9dp"
                    android:background="@drawable/bg_circle_chip"
                    android:src="@drawable/ic_undo"
                    android:tint="?attr/wpText2"
                    android:contentDescription="@string/undo_answer"/>

                <ImageView
                    android:id="@+id/btnFav"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_marginStart="8dp"
                    android:padding="10dp"
                    android:background="@drawable/bg_circle_chip"
                    android:src="@drawable/ic_heart"
                    android:tint="?attr/wpRed"
                    android:contentDescription="@string/fav_added"/>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/colMain"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center"
                android:animateLayoutChanges="true"
                android:paddingStart="22dp"
                android:paddingEnd="22dp"
                android:paddingBottom="22dp">

                <TextView
                    android:id="@+id/tvWord"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:maxLines="2"
                    android:ellipsize="end"
                    android:textColor="?attr/wpText"
                    android:textSize="34sp"
                    android:textStyle="bold"/>

                <TextView
                    android:id="@+id/tvPhonetic"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:textColor="?attr/wpText2"
                    android:textSize="15sp"/>

                <TextView
                    android:id="@+id/tvHint"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    android:background="@drawable/bg_pill_brand"
                    android:paddingStart="13dp"
                    android:paddingEnd="13dp"
                    android:paddingTop="6dp"
                    android:paddingBottom="6dp"
                    android:text="@string/tap_reveal"
                    android:textColor="?attr/wpBrand"
                    android:textSize="12.5sp"/>

                <LinearLayout
                    android:id="@+id/meaningBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center_horizontal"
                    android:visibility="gone">

                    <View
                        android:layout_width="56dp"
                        android:layout_height="3dp"
                        android:layout_marginTop="22dp"
                        android:background="?attr/wpBrand"/>

                    <TextView
                        android:id="@+id/tvMeaning"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:gravity="center"
                        android:lineSpacingExtra="7sp"
                        android:textColor="?attr/wpText"
                        android:textSize="18sp"/>

                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <!-- 按钮区 -->
        <LinearLayout
            android:id="@+id/actions"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingTop="12dp"
            android:paddingBottom="18dp"
            android:alpha="0"
            android:visibility="invisible">

            <TextView
                android:id="@+id/btnNo"
                android:layout_width="0dp"
                android:layout_height="58dp"
                android:layout_weight="1"
                android:background="@drawable/bg_btn_red"
                android:gravity="center"
                android:text="@string/dont_know"
                android:textColor="?attr/wpRed"
                android:textSize="16sp"
                android:textStyle="bold"/>

            <TextView
                android:id="@+id/btnYes"
                android:layout_width="0dp"
                android:layout_height="58dp"
                android:layout_weight="1"
                android:layout_marginStart="12dp"
                android:background="@drawable/bg_btn_green"
                android:gravity="center"
                android:text="@string/got_it"
                android:textColor="#FFFFFFFF"
                android:textSize="16sp"
                android:textStyle="bold"/>
        </LinearLayout>
    </LinearLayout>

    <!-- ===== 结算覆盖层 ===== -->
    <LinearLayout
        android:id="@+id/result"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:background="?attr/wpBg"
        android:gravity="center_horizontal"
        android:visibility="gone"
        android:fitsSystemWindows="true"
        android:paddingStart="22dp"
        android:paddingEnd="22dp">

        <Space
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="0.12"/>

        <FrameLayout
            android:layout_width="96dp"
            android:layout_height="96dp"
            android:background="@drawable/bg_circle_green">

            <ImageView
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_check"
                android:tint="?attr/wpGreen"
                android:contentDescription="@null"/>
        </FrameLayout>

        <TextView
            android:id="@+id/resultTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="@string/session_done"
            android:textColor="?attr/wpText"
            android:textSize="24sp"
            android:textStyle="bold"/>

        <TextView
            android:id="@+id/resultSub"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="7dp"
            android:gravity="center"
            android:textColor="?attr/wpText2"
            android:textSize="13sp"/>

        <!-- 2×2 数据卡 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:orientation="vertical"
            android:background="@drawable/bg_card_22"
            android:paddingTop="16dp"
            android:paddingBottom="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="center">
                    <TextView android:id="@+id/rsFirst" style="@style/StatVal" android:textColor="?attr/wpGreen" android:text="0"/>
                    <TextView style="@style/StatLbl" android:text="@string/first_learn"/>
                </LinearLayout>

                <View android:layout_width="1dp" android:layout_height="match_parent" android:background="?attr/wpLine"/>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="center">
                    <TextView android:id="@+id/rsRetry" style="@style/StatVal" android:textColor="?attr/wpRed" android:text="0"/>
                    <TextView style="@style/StatLbl" android:text="@string/retry_learn"/>
                </LinearLayout>
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="14dp"
                android:background="?attr/wpLine"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="center">
                    <TextView android:id="@+id/rsAcc" style="@style/StatVal" android:text="100%"/>
                    <TextView style="@style/StatLbl" android:text="@string/accuracy"/>
                </LinearLayout>

                <View android:layout_width="1dp" android:layout_height="match_parent" android:background="?attr/wpLine"/>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="center">
                    <TextView android:id="@+id/rsTime" style="@style/StatVal" android:text="0:00"/>
                    <TextView style="@style/StatLbl" android:text="@string/duration"/>
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <!-- 错词列表卡 -->
        <LinearLayout
            android:id="@+id/wrongWrap"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="vertical"
            android:background="@drawable/bg_card_22"
            android:padding="15dp"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/due_label"
                android:textColor="?attr/wpText2"
                android:textSize="12sp"
                android:textStyle="bold"/>

            <LinearLayout
                android:id="@+id/wrongBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"/>
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="0.28"/>

        <TextView
            android:id="@+id/btnNext"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:background="@drawable/bg_btn_gradient"
            android:gravity="center"
            android:text="@string/next_group"
            android:textColor="#FFFFFFFF"
            android:textSize="16sp"
            android:textStyle="bold"/>

        <TextView
            android:id="@+id/btnTest"
            android:layout_width="match_parent"
            android:layout_height="46dp"
            android:layout_marginTop="4dp"
            android:gravity="center"
            android:text="@string/habit_test"
            android:textColor="?attr/wpBrand"
            android:textSize="14.5sp"
            android:textStyle="bold"/>

        <TextView
            android:id="@+id/btnExit"
            android:layout_width="match_parent"
            android:layout_height="46dp"
            android:gravity="center"
            android:text="@string/back_shelf"
            android:textColor="?attr/wpText2"
            android:textSize="14sp"/>

        <Space
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="0.1"/>
    </LinearLayout>

    <com.aidemo.wordsprint.ConfettiView
        android:id="@+id/confetti"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone"/>
</FrameLayout>
